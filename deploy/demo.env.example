# Copy to deploy/demo.env (ignored by Git) and fill in every value. Never commit real values.
# docker compose -f deploy/compose.demo.yaml --env-file deploy/demo.env up -d --build

# Public host name pointing at this server, e.g. 203-0-113-10.sslip.io or demo.example.com.
DEMO_DOMAIN=
# Keep 80/443 on a public server: certificate issuance needs them.
DEMO_HTTP_PORT=80
DEMO_HTTPS_PORT=443

# SQL Server passwords: at least 8 characters with upper case, lower case and digits.
# Avoid $ and quotes: they would need escaping in Compose and sqlcmd.
SQL_SA_PASSWORD=
IDENTITY_MIGRATION_PASSWORD=
IDENTITY_DB_PASSWORD=
CATALOG_MIGRATION_PASSWORD=
CATALOG_DB_PASSWORD=

# Base64 body of the RSA key pair as a single line, without the BEGIN/END lines:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt-private.pem
#   openssl pkey -in jwt-private.pem -pubout -out jwt-public.pem
#   grep -v -- '-----' jwt-private.pem | tr -d '\n'
#   grep -v -- '-----' jwt-public.pem | tr -d '\n'
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=

# Optional. Password reset email fails until these are set.
DEMO_MAIL_USERNAME=
DEMO_MAIL_PASSWORD=

# Lower this if span volume becomes a problem; 1.0 records every request.
TRACING_SAMPLING_PROBABILITY=1.0
