# Load these into the process environment; Spring does not auto-load this file.
# Provision catalog_db and separate migration/runtime users before startup.
CATALOG_DB_URL=jdbc:sqlserver://localhost:1433;databaseName=catalog_db;encrypt=true;trustServerCertificate=true
CATALOG_DB_USERNAME=catalog_app
CATALOG_DB_PASSWORD=
CATALOG_MIGRATION_USERNAME=catalog_migrator
CATALOG_MIGRATION_PASSWORD=
JWT_ISSUER=cinema-identity
JWT_JWKS_URI=http://localhost:8081/.well-known/jwks.json
EUREKA_SERVER_URL=http://localhost:8761/eureka/
# Calendar zone for "today" in movie release rules.
CATALOG_BUSINESS_ZONE=Asia/Ho_Chi_Minh
TRACING_EXPORT_ENABLED=false
ZIPKIN_ENDPOINT=http://localhost:9411/api/v2/spans
