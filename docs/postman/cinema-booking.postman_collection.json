        }
      }
    },
    {
      "name": "07 Another customer's hold -> 403",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('403 HOLD_NOT_OWNED', () => { pm.response.to.have.status(403); pm.expect(pm.response.json().code).to.eql('HOLD_NOT_OWNED'); });"
