{
  "info": {
    "name": "Cinema Booking - Booking, Payment, Tickets & Check-in",
    "description": "Run docs/postman/prepare-booking-tests.ps1 first (fresh holds + voucher), import booking-local.postman_environment.json, select it, then Run collection in order. Requests 15-23 need booking.demo-payment.enabled=true and an ADMIN account (adminUsername/adminPassword).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "previewTotalA",
      "value": ""
    },
    {
      "key": "bookingIdA",
      "value": ""
    },
    {
      "key": "previewTotalB",
      "value": ""
    },
    {
      "key": "keyA",
      "value": ""
    },
    {
      "key": "ticketIdA",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Login USER",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 USER token', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().roles).to.include('USER'); });",
              "pm.collectionVariables.set('token', pm.response.json().accessToken);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{loginUrl}}/api/v1/auth/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"{{username}}\",\"password\":\"{{password}}\"}"
        },
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "02 Preview hold A -> 200, server totals",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const n = v => Math.round(Number(v) * 100) / 100;",
              "const b = pm.response.json();",
              "pm.test('200', () => pm.response.to.have.status(200));",
              "pm.test('2 seats, Coca x2 = 90000', () => { pm.expect(b.ticketItems.length).to.eql(2); pm.expect(n(b.concessionSubtotal)).to.eql(90000); });",
              "pm.test('total = subtotal - discount', () => pm.expect(n(b.total)).to.eql(n(b.subtotal) - n(b.discountAmount)));",
              "pm.collectionVariables.set('previewTotalA', b.total);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/customer/bookings/preview",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"holdId\":\"{{holdA}}\",\"showtimeId\":\"{{showtimeA}}\",\"showtimeSeatIds\":{{seatsA}},\"concessions\":[{\"concessionId\":\"DR000002\",\"quantity\":2}],\"voucherCode\":null}"
        }
      }
    },
    {
      "name": "03 Create booking A -> 201 PENDING_PAYMENT",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.collectionVariables.set('keyA', 'pm-' + pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "const n = v => Math.round(Number(v) * 100) / 100;",
              "const b = pm.response.json();",
              "pm.test('201 + Location', () => { pm.response.to.have.status(201); pm.expect(pm.response.headers.get('Location')).to.include(b.bookingId); });",
              "pm.test('PENDING_PAYMENT, same total as preview', () => { pm.expect(b.status).to.eql('PENDING_PAYMENT'); pm.expect(n(b.totalAmount)).to.eql(n(pm.collectionVariables.get('previewTotalA'))); });",
              "pm.test('pay within about 5 minutes', () => { const m = (new Date(b.expiresAt) - Date.now()) / 60000; pm.expect(m).to.be.within(4, 6); });",
              "pm.collectionVariables.set('bookingIdA', b.bookingId);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/customer/bookings",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{keyA}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"holdId\":\"{{holdA}}\",\"showtimeId\":\"{{showtimeA}}\",\"showtimeSeatIds\":{{seatsA}},\"concessions\":[{\"concessionId\":\"DR000002\",\"quantity\":2}],\"voucherCode\":null}"
        }
      }
    },
    {
      "name": "04a Same Idempotency-Key + same body -> 200 same booking",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 replay of the same booking', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().bookingId).to.eql(pm.collectionVariables.get('bookingIdA')); pm.expect(pm.response.json().status).to.eql('PENDING_PAYMENT'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/customer/bookings",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{keyA}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"holdId\":\"{{holdA}}\",\"showtimeId\":\"{{showtimeA}}\",\"showtimeSeatIds\":{{seatsA}},\"concessions\":[{\"concessionId\":\"DR000002\",\"quantity\":2}],\"voucherCode\":null}"
        }
      }
    },
    {
      "name": "04b New key, same (used) hold -> 409",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('409 HOLD_EXPIRED', () => { pm.response.to.have.status(409); pm.expect(pm.response.json().code).to.eql('HOLD_EXPIRED'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/customer/bookings",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"holdId\":\"{{holdA}}\",\"showtimeId\":\"{{showtimeA}}\",\"showtimeSeatIds\":{{seatsA}},\"concessions\":[{\"concessionId\":\"DR000002\",\"quantity\":2}],\"voucherCode\":null}"
        }
      }
    },
    {
      "name": "04c Same key + different body -> 409",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('409 IDEMPOTENCY_KEY_REUSED', () => { pm.response.to.have.status(409); pm.expect(pm.response.json().code).to.eql('IDEMPOTENCY_KEY_REUSED'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/customer/bookings",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{keyA}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"holdId\":\"{{holdA}}\",\"showtimeId\":\"{{showtimeA}}\",\"showtimeSeatIds\":{{seatsA}},\"concessions\":[{\"concessionId\":\"DR000002\",\"quantity\":3}],\"voucherCode\":null}"
        }
      }
    },
    {
      "name": "04d Missing Idempotency-Key -> 400",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('400 IDEMPOTENCY_KEY_INVALID', () => { pm.response.to.have.status(400); pm.expect(pm.response.json().code).to.eql('IDEMPOTENCY_KEY_INVALID'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/customer/bookings",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"holdId\":\"{{holdA}}\",\"showtimeId\":\"{{showtimeA}}\",\"showtimeSeatIds\":{{seatsA}},\"concessions\":[{\"concessionId\":\"DR000002\",\"quantity\":2}],\"voucherCode\":null}"
        }
      }
    },
    {
      "name": "05 Preview a consumed hold -> 409",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('409 HOLD_EXPIRED', () => { pm.response.to.have.status(409); pm.expect(pm.response.json().code).to.eql('HOLD_EXPIRED'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/customer/bookings/preview",
