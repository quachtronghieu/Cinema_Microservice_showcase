          "listen": "test",
          "script": {
            "exec": [
              "pm.test('409 CONCESSION_UNAVAILABLE', () => { pm.response.to.have.status(409); pm.expect(pm.response.json().code).to.eql('CONCESSION_UNAVAILABLE'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/customer/bookings",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"holdId\":\"{{holdB}}\",\"showtimeId\":\"{{showtimeB}}\",\"showtimeSeatIds\":{{seatsB}},\"concessions\":[{\"concessionId\":\"PC000003\",\"quantity\":2}],\"voucherCode\":null}"
        }
      }
    },
    {
      "name": "10 Preview hold B with voucher -> 10% off",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const n = v => Math.round(Number(v) * 100) / 100;",
              "const b = pm.response.json();",
              "pm.test('200 voucher applied', () => { pm.response.to.have.status(200); pm.expect(b.voucher.code).to.eql(pm.environment.get('voucherCode')); });",
              "pm.test('discount = 10% of subtotal', () => pm.expect(n(b.discountAmount)).to.eql(n(n(b.subtotal) * 0.10)));",
              "pm.collectionVariables.set('previewTotalB', b.total);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/customer/bookings/preview",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"holdId\":\"{{holdB}}\",\"showtimeId\":\"{{showtimeB}}\",\"showtimeSeatIds\":{{seatsB}},\"concessions\":[{\"concessionId\":\"DR000002\",\"quantity\":2}],\"voucherCode\":\"{{voucherCode}}\"}"
        }
      }
    },
    {
      "name": "11 Create booking B with voucher -> 201",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const n = v => Math.round(Number(v) * 100) / 100;",
              "const b = pm.response.json();",
              "pm.test('201 discounted total', () => { pm.response.to.have.status(201); pm.expect(n(b.totalAmount)).to.eql(n(pm.collectionVariables.get('previewTotalB'))); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
