          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"holdId\":\"{{holdOther}}\",\"showtimeId\":\"{{showtimeOther}}\",\"showtimeSeatIds\":{{seatsOther}},\"concessions\":[{\"concessionId\":\"DR000002\",\"quantity\":2}],\"voucherCode\":null}"
        }
      }
    },
    {
      "name": "08 Seats differ from the hold -> 409",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('409 HOLD_SELECTION_MISMATCH', () => { pm.response.to.have.status(409); pm.expect(pm.response.json().code).to.eql('HOLD_SELECTION_MISMATCH'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/customer/bookings",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"holdId\":\"{{holdB}}\",\"showtimeId\":\"{{showtimeB}}\",\"showtimeSeatIds\":[\"{{seatB1}}\",\"NOT-HELD-SEAT\"],\"concessions\":[{\"concessionId\":\"DR000002\",\"quantity\":2}],\"voucherCode\":null}"
        }
      }
    },
    {
      "name": "09 Inactive concession -> 409",
      "event": [
