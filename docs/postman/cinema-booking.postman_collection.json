          "listen": "test",
          "script": {
            "exec": [
              "const b = pm.response.json();",
              "pm.test('200 with who and when', () => { pm.response.to.have.status(200); pm.expect(b.ticketId).to.eql(pm.collectionVariables.get('ticketIdA')); pm.expect(b.checkedInBy).to.be.a('string'); pm.expect(b.checkedInAt).to.be.a('string'); });"
